# -----------------------------------------------------------------------------
# Copy to .env.local for local development, and add the same values in Vercel
# (Project -> Settings -> Environment Variables) for Production and Preview.
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Absolute origin used for canonical URLs, Open Graph tags and JSON-LD.
# Leave unset locally and on Vercel (it is inferred from the request / VERCEL_URL).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional. Only prefills the login form and the "demo" hints in the UI.
# NEXT_PUBLIC_DEMO_EMAIL=demo@careerbuilder.dev
# NEXT_PUBLIC_DEMO_PASSWORD=demo-recruiter-2024
# NEXT_PUBLIC_DEMO_COMPANY_SLUG=northwind-labs

# NOTE: the Supabase service_role key is deliberately NOT used anywhere in this app.
# All access goes through the anon key + Row Level Security. Never add it here.
